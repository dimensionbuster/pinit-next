{
  "manifest_version": 3,
  "name": "PinIt",
  "version": "0.1.0",
  "description": "Open any image, or the playing video, in a PinIt always-on-top window.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "tabCapture"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PinIt"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}